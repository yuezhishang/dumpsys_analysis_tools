# 统一换行符策略 —— 防止 core.autocrlf 把 Shell 脚本转成 CRLF 后 shebang 失效
# （CRLF 的 start-tool.sh 在 macOS / Linux / Git Bash 下会报
#   "/usr/bin/env: 'bash\r': No such file or directory"，整个启动器不可用）
* text=auto
*.sh   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.png  binary
*.jpg  binary
*.exe  binary
